#!/usr/bin/env bash
# shellcheck shell=bash
#
# quetrex-api — self-contained, token-safe API client for the Quetrex plugin's
# slash commands. Shipped in the plugin's bin/ directory, which Claude Code adds
# to PATH, so commands invoke it BY NAME (never by sourcing a lib):
#
#     quetrex-api GET  /api/users/me
#     quetrex-api POST /api/tasks "$JSON_BODY"
#     quetrex-api project-code
#     quetrex-api task-status SMA-1 in_progress
#
# It is a single EXECUTABLE (not a sourced library): in a plugin slash-command
# bash environment ${CLAUDE_PLUGIN_ROOT}/${CLAUDE_PLUGIN_DATA} are UNSET, so a
# command cannot `source` a lib by path — but the plugin's bin/ is on PATH, so
# this tool is callable by name. All the logic the commands used to get from
# `source ~/.claude/lib/quetrex-api.sh` is inlined here.
#
# ---------------------------------------------------------------------------
# CONTRACTS (read here, never written here — owned by /quetrex-setup:login and
# /quetrex-setup:init). Two JSON files, two shapes:
#
#   AUTH — machine level, outside any repo:  ~/.quetrex/auth.json
#     { "kanbanUrl": "...", "token": "<per-user bearer>", "expiresAt": "<iso8601>" }
#   Written by /quetrex-setup:login. Read here via resolve_auth.
#
#   PROJECT BINDING — committed per repo:  ./.quetrex/project.json
#     { "projectCode": "SMA", "kanbanUrl": "..." }
#   Written by /quetrex-setup:init, committed. Read here via resolve_project, which
#   walks up the directory tree from $PWD to find it.
#
# ---------------------------------------------------------------------------
# TOKEN SAFETY — the single most important invariant of this file:
#
#   The bearer token is NEVER printed to stdout/stderr, NEVER written to a log,
#   NEVER passed on a command line (so it cannot appear in `ps aux`), and is
#   NEVER exposed by `curl -v` or a shell `set -x` trace. It lives only in
#   _QX_TOKEN (in-process) and, transiently, in a 0600 temp curl config file
#   that is removed with an explicit `rm` the instant curl returns. Do not add
#   `set -x`, `-v`, or `echo "$_QX_TOKEN"` anywhere in this file.
#
# Requirements: curl and node (>=18). No jq / python3 dependency.
# ---------------------------------------------------------------------------

# Module-level state (set by the resolvers, read by qapi):
#     QX_KANBAN_URL    base URL (source of truth = auth.json)
#     QX_PROJECT_CODE  project code from project.json
#     _QX_TOKEN        bearer token (underscore = "private"; never echoed)

# _qx_node <script> [value...]
#   Run a node one-liner with every UNTRUSTED value passed through the
#   ENVIRONMENT — as process.env.QX_A1 .. QX_A4, in the order given — instead of
#   argv. THE ONLY way this file is allowed to hand node a caller-controlled
#   value.
#
#   WHY. `node -e '<script>' "$v"` hands $v to NODE's own CLI parser, which
#   inspects that first trailing token for flags it recognises BEFORE the eval'd
#   script ever runs. v="--version" or v="-v" makes node print its version banner
#   and exit 0; v="--help" prints its usage and exits 0. Every one of those was
#   read by qx_code_is_board_shaped as "exit 0 = this IS a code the board could
#   have issued" — a total bypass of the predicate resolve_project and init's
#   advisory line both depend on, for a value that never reached the regex.
#
#   WHY NOT `--`. A `node -e '<script>' -- "$v"` terminator does close the
#   parse, but it leaves the value on argv (so it is visible in `ps aux`, which
#   this file's token-safety invariant exists to prevent) and it leaves every
#   future call site one forgotten `--` away from the same bug. The environment
#   is not parsed by anything, so it cannot be mis-parsed — the failure mode is
#   removed rather than guarded against. All four slots are always set, so an
#   ambient QX_A* in the operator's environment can never leak into a script.
_qx_node() {
  local _qx_script="$1"
  QX_A1="${2-}" QX_A2="${3-}" QX_A3="${4-}" QX_A4="${5-}" node -e "$_qx_script"
}

# _qx_json_get <file> <dot.path>
#   Print one field value from a JSON file. Exit 1 if the file is unreadable,
#   not valid JSON, or the path resolves to null/undefined.
_qx_json_get() {
  _qx_node '
    const fs = require("fs");
    const f = process.env.QX_A1, p = process.env.QX_A2;
    let o;
    try { o = JSON.parse(fs.readFileSync(f, "utf8")); } catch { process.exit(1); }
    const v = p.split(".").reduce((a, k) => (a == null ? a : a[k]), o);
    if (v == null) { process.exit(1); }
    process.stdout.write(String(v));
  ' "$1" "$2"
}

# resolve_auth
#   Read ~/.quetrex/auth.json; validate presence, fields, and non-expiry.
#   Sets QX_KANBAN_URL and _QX_TOKEN. On any failure prints "Run /quetrex-setup:login"
#   to stderr and returns 1.
resolve_auth() {
  local f="$HOME/.quetrex/auth.json"
  if [ ! -f "$f" ]; then
    echo "Run /quetrex-setup:login" >&2
    return 1
  fi

  QX_KANBAN_URL="$(_qx_json_get "$f" kanbanUrl)" || { echo "Run /quetrex-setup:login" >&2; return 1; }
  _QX_TOKEN="$(_qx_json_get "$f" token)"         || { echo "Run /quetrex-setup:login" >&2; return 1; }

  local exp
  exp="$(_qx_json_get "$f" expiresAt)" || { echo "Run /quetrex-setup:login" >&2; return 1; }

  # Expired? node date math, no jq dependency. exit 0 = still valid.
  if ! _qx_node 'process.exit(new Date(process.env.QX_A1) > new Date() ? 0 : 1)' "$exp"; then
    echo "Run /quetrex-setup:login" >&2
    return 1
  fi

  return 0
}

# qx_binding_path
#   Print the absolute path of the repo's .quetrex/project.json by walking up from
#   $PWD. Prints the path on stdout and returns 0 if found; prints nothing and
#   returns 1 on miss. Never reads or emits any secret; touches no auth state.
qx_binding_path() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.quetrex/project.json" ]; then
      printf '%s\n' "$dir/.quetrex/project.json"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# qx_code_is_board_shaped <code>
#   Is this a project code the BOARD could have issued? deriveCode() yields
#   exactly three A-Z letters and assignUniqueCode() appends a decimal collision
#   suffix (quetrex-kanban src/lib/code.ts), into a varchar(8) column, and
#   PATCH /api/projects/:code deliberately cannot rename it (updateProjectSchema
#   omits `code`) — so nothing else can ever mint one, and a code outside this
#   shape cannot resolve against the board either (the route matches on
#   eq(projects.code, code)).
#
#   THE single definition of that shape. resolve_project enforces it below so
#   every consumer inherits it, rather than each command guarding the one line
#   it happens to print — a project code out of a cloned repo's
#   .quetrex/project.json used to be interpolated straight into a copy-paste
#   `quetrex-api PATCH` one-liner, and guarding the print site would only have
#   waited for the next message someone added.
#
#   node, not `grep -Eq`: grep is line-oriented and would accept a code whose
#   first line is "QUE"; JS ^...$ without /m is anchored to the whole string.
qx_code_is_board_shaped() {
  _qx_node 'const c = process.env.QX_A1; process.exit(/^[A-Z]{3}[0-9]*$/.test(c) && c.length <= 8 ? 0 : 1)' "$1" 2>/dev/null
}

# qx_repo_norm <value>
#   The board's own owner/repo comparison shape, in ONE place so init and
#   doctor cannot drift from each other or from it. quetrex-kanban
#   src/lib/branch-ref.ts:44-45 compares
#     projectRepo.trim().toLowerCase().replace(/\.git$/, "").replace(/\/+$/, "")
#   — four operations, and `.git` is stripped BEFORE the trailing slashes, so
#   `dealerq.git/` normalises to `dealerq.git` exactly as the board leaves it.
#   Lowercasing alone was not enough: a stored `dealerq.git` read as a DIFFERENT
#   repo from origin `dealerq`, which drew a false cross in doctor and a fix
#   line that resolved nothing. Only the trailing `.git` is reachable through
#   the API today (githubSlug is zod-trimmed and its charset rejects `/`), but
#   the whole shape lives here so it stays the board's shape.
qx_repo_norm() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/\.git$//; s#/+$##'
}

# resolve_project
#   Walk up from $PWD to find .quetrex/project.json. Sets QX_PROJECT_CODE.
#   Keeps auth.json's kanbanUrl as the source of truth, falling back to the
#   binding's kanbanUrl only if auth has not set one. On miss prints
#   "Run /quetrex-setup:init" to stderr and returns 1.
resolve_project() {
  local dir="$PWD" f=""
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.quetrex/project.json" ]; then
      f="$dir/.quetrex/project.json"
      break
    fi
    dir="$(dirname "$dir")"
  done

  if [ -z "$f" ]; then
    echo "Run /quetrex-setup:init" >&2
    return 1
  fi

  QX_PROJECT_CODE="$(_qx_json_get "$f" projectCode)" || { echo "Run /quetrex-setup:init" >&2; return 1; }

  # Validate HERE, once, so every consumer inherits it. A binding file is
  # attacker-supplied in a cloned repo and nothing else checks it; a code the
  # board could not have issued resolves to no project anyway, so refusing is
  # both safer and more honest than carrying it forward.
  if ! qx_code_is_board_shaped "$QX_PROJECT_CODE"; then
    echo "quetrex-api: $f holds a projectCode the board could not have issued (it mints three A-Z letters plus an optional collision suffix). Re-run /quetrex-setup:init to rebind this repo." >&2
    QX_PROJECT_CODE=""
    return 1
  fi

  # auth's kanbanUrl wins; only fall back to the binding if auth set nothing.
  if [ -z "${QX_KANBAN_URL:-}" ]; then
    QX_KANBAN_URL="$(_qx_json_get "$f" kanbanUrl)" || { echo "Run /quetrex-setup:init" >&2; return 1; }
  fi

  return 0
}

# qapi <METHOD> <PATH> [json_body]
#   Token-safe curl wrapper. Requires resolve_auth to have run first.
#     - injects the bearer via a 0600 temp curl config file (-K), so the token
#       never appears in argv/stdout/logs; that config file is wiped the instant
#       curl returns (explicit rm — portable across bash and zsh).
#     - passes -q FIRST on every curl invocation (curl requires it to be the
#       first argument to take effect), which disables reading the operator's
#       ~/.curlrc. Without this, a `location` (follow-redirects) line in that
#       file — an ordinary developer setting — would make curl silently
#       follow a redirect: the ORIGINAL request (and its write) is delivered
#       and possibly committed to the original URL, then curl's exit code and
#       %{http_code} reflect only the REDIRECT TARGET. That breaks the curl
#       exit-code classification below: a 6/7 on the redirect target would be
#       misread as "never reached the server" when the original POST already
#       had.
#     - 401      -> "Run /quetrex-setup:login" (stderr), return 1
#     - 403/404  -> "No access — contact your administrator" (stderr), return 1
#     - other non-2xx -> "Quetrex API error (HTTP <code>): <server's response
#       body, truncated, token-scrubbed>" (stderr), return 1. A bare status code
#       with no diagnostic is what made a genuinely transient 500 indistinguishable
#       from the tool being broken; the server's own message is what makes it
#       actionable.
#     - 2xx      -> prints the JSON response body to stdout, return 0
#
#   RETRY. A connection-level failure (curl_rc != 0, normalized to code="000")
#   is NOT one bucket — curl exit codes 52 (empty reply), 56 (failure
#   receiving data), 28 (timeout) and 18 (partial file) all mean the request
#   may have been fully transmitted, and fully processed and committed
#   server-side, before the response was lost on the wire. This is exactly
#   what a Fly.io machine restart, an OOM kill, or a post-commit crash looks
#   like on the wire — the classic lost-response problem. Only curl exit 6
#   (couldn't resolve host) and 7 (failed to connect / connection refused)
#   prove the TCP connection was never established, so the request cannot
#   have reached application code — and that is only true because -q (above)
#   stops curl from following a .curlrc redirect setting; without it, a 6/7
#   could be the REDIRECT TARGET failing after the original request already
#   landed. Any OTHER curl exit code is unclassified and FAILS CLOSED (see
#   the case statement in qapi). So:
#     - GET/PUT/DELETE are idempotent by HTTP semantics — repeating the exact
#       same request converges to the same end state — so any 5xx, and any
#       connection-level failure regardless of curl_rc, is retried.
#     - POST/PATCH are NOT safe to retry on a generic 5xx or an unclassified/
#       lost-response connection failure: the request may have already been
#       fully processed server-side (write committed), and a repeated POST
#       here creates a permanent duplicate task (there is no DELETE
#       /api/tasks). Retried ONLY on: curl exit 6/7 (never reached the
#       server), HTTP 429 (rate-limited — never dispatched), and HTTP 503
#       (service unavailable — a gateway/load-balancer rejection that, by
#       definition, occurs before the request reaches application code).
#       Never 500/502/504, and never an unclassified curl failure, for these
#       methods.
#   Bounded at 3 total attempts, 1s/2s backoff between them, each attempt
#   bounded by --connect-timeout/--max-time so a hung server can't triple an
#   unbounded wait, and every retry is announced on stderr so a pause is
#   never silent.
qapi() {
  # NOTE: do not name a local `path` — zsh ties lowercase `path` to $PATH.
  local method="$1" endpoint="$2" body="${3:-}"
  local url="${QX_KANBAN_URL}${endpoint}"
  local cfg bodyf code="" curl_rc=0 rc=1
  local attempt max_attempts=3

  for attempt in 1 2 3; do
    cfg="$(mktemp)"   || { echo "Quetrex API error (temp file)" >&2; return 1; }
    bodyf="$(mktemp)" || { rm -f "$cfg"; echo "Quetrex API error (temp file)" >&2; return 1; }
    # Both temp files may hold sensitive bytes: cfg the bearer token, bodyf the
    # response body (which for /secrets/export is the vault map). Lock both to
    # 0600 on creation and rm -f each on every path below, every attempt.
    chmod 600 "$cfg" "$bodyf"

    # The token's only on-disk home: a 0600 curl config (-K), never on argv.
    printf 'header = "Authorization: Bearer %s"\n' "$_QX_TOKEN" > "$cfg"

    if [ -n "$body" ]; then
      code="$(curl -q -sS -K "$cfg" \
        --connect-timeout 10 --max-time 30 \
        -H 'Content-Type: application/json' \
        -X "$method" --data "$body" \
        -o "$bodyf" -w '%{http_code}' --url "$url")"
    else
      code="$(curl -q -sS -K "$cfg" \
        --connect-timeout 10 --max-time 30 \
        -X "$method" \
        -o "$bodyf" -w '%{http_code}' --url "$url")"
    fi
    curl_rc=$?

    # Token's on-disk copy is no longer needed — wipe it before doing anything else.
    rm -f "$cfg"

    # A curl-level failure (couldn't connect, timed out below the HTTP layer,
    # TLS error, etc.) never produces a valid 3-digit code — normalize so the
    # rest of the function has one unambiguous value to match on for display.
    [ "$curl_rc" -eq 0 ] && [ -n "$code" ] || code="000"

    local should_retry=0
    if [ "$curl_rc" -ne 0 ] || [ "$code" = "000" ]; then
      # Connection-level failure. Whether a repeat can create a duplicate
      # write depends on whether the request could possibly have reached
      # application code — that is NOT true of every curl exit code, so it
      # must be classified rather than treated as one bucket. See the header
      # comment for the reproduction this guards: a lost response after a
      # committed write, blindly retried into a permanent duplicate task.
      case "$curl_rc" in
        6 | 7)
          # 6 = couldn't resolve host, 7 = failed to connect (e.g. connection
          # refused). The TCP connection was never established, so the
          # request cannot have reached the server. Safe to retry ANY method.
          should_retry=1
          ;;
        18 | 28 | 52 | 56)
          # 18 = partial file, 28 = operation timeout, 52 = empty reply from
          # server, 56 = failure receiving network data. In every one of
          # these the request may already have been fully transmitted — and
          # fully processed and committed server-side — before the response
          # was lost. Safe to retry only for idempotent methods; retrying
          # POST/PATCH here can create a permanent duplicate write.
          case "$method" in
            GET | PUT | DELETE) should_retry=1 ;;
          esac
          ;;
        *)
          # Any other/unclassified curl exit code. FAIL CLOSED: we cannot
          # positively prove the request never reached application code, so
          # a non-idempotent method is never retried here. Idempotent
          # methods converge to the same end state regardless of failure
          # mode, so they keep retrying as before.
          case "$method" in
            GET | PUT | DELETE) should_retry=1 ;;
          esac
          ;;
      esac
    else
      case "$method" in
        GET | PUT | DELETE)
          case "$code" in
            5??) should_retry=1 ;;
          esac
          ;;
        POST | PATCH)
          case "$code" in
            429 | 503) should_retry=1 ;;
          esac
          ;;
      esac
    fi

    if [ "$should_retry" -eq 1 ] && [ "$attempt" -lt "$max_attempts" ]; then
      local why
      if [ "$curl_rc" -ne 0 ] || [ "$code" = "000" ]; then
        why="connection failed"
      else
        why="HTTP $code"
      fi
      echo "Quetrex API: transient error ($why) on $method $endpoint — retrying ($((attempt + 1))/$max_attempts)..." >&2
      rm -f "$bodyf"
      sleep "$attempt"
      continue
    fi

    break
  done

  case "$code" in
    2*)
      cat "$bodyf"
      rc=0
      ;;
    401)
      echo "Run /quetrex-setup:login" >&2
      ;;
    403 | 404)
      echo "No access — contact your administrator" >&2
      ;;
    *)
      local errbody
      errbody="$(cat "$bodyf" 2>/dev/null)"
      # Defensive scrub: the token should never appear in a response body (it
      # is the CLIENT's own credential, not something the server echoes), but
      # this guarantees it cannot leak through this path even if a server ever
      # reflected the Authorization header back (many debug/error pages do).
      # Quoting $_QX_TOKEN inside the pattern forces a literal match, never a
      # glob, so token bytes that happen to look like glob metacharacters are
      # matched byte-for-byte rather than (mis)interpreted.
      if [ -n "${_QX_TOKEN:-}" ]; then
        errbody="${errbody//"$_QX_TOKEN"/[REDACTED]}"
      fi
      # Truncate so one enormous HTML error page can't flood the operator's
      # terminal; a few hundred characters is enough to be actionable.
      if [ "${#errbody}" -gt 500 ]; then
        errbody="$(printf '%s' "$errbody" | head -c 500)... [truncated]"
      fi
      if [ "$code" = "000" ]; then
        case "$method" in
          POST | PATCH)
            case "$curl_rc" in
              6 | 7)
                # Never reached the server (see classification above) — the
                # honest "nothing happened" message.
                echo "Quetrex API error: could not reach the server (connection failed) after $attempt attempt(s)" >&2
                ;;
              *)
                # Lost-response / unclassified: the request may have already
                # reached the server and been committed before the response
                # was lost — that is precisely why this was NOT retried. Do
                # not tell the operator "nothing happened"; that is what
                # sends him to run it again and create a real duplicate.
                echo "Quetrex API error: no response after $attempt attempt(s) — the request may have already reached the server. CHECK before retrying manually (repeating a $method here could create a duplicate)." >&2
                ;;
            esac
            ;;
          *)
            echo "Quetrex API error: could not reach the server (connection failed) after $attempt attempt(s)" >&2
            ;;
        esac
      elif [ -n "$errbody" ]; then
        echo "Quetrex API error (HTTP $code): $errbody" >&2
      else
        echo "Quetrex API error (HTTP $code): <empty response body>" >&2
      fi
      ;;
  esac

  rm -f "$bodyf"
  return "$rc"
}

# ---------------------------------------------------------------------------
# CONVENIENCE WRAPPERS over qapi. Each builds its JSON body with
# node/JSON.stringify (never echo, never hand-built strings) and routes through
# qapi, INHERITING qapi's token safety.
# ---------------------------------------------------------------------------

# qx_task_status TASK_ID STATUS  -> PATCH /api/tasks/$ID {status}
qx_task_status() {
  local body
  body="$(_qx_node 'process.stdout.write(JSON.stringify({status:process.env.QX_A1}))' "$2")" || return 1
  _qx_require_ref "$1" || return 1
  qapi PATCH "/api/tasks/$1" "$body" >/dev/null
}

# qx_task_ainote TASK_ID NOTE  -> PATCH /api/tasks/$ID {aiNotes}
qx_task_ainote() {
  local body
  body="$(_qx_node 'process.stdout.write(JSON.stringify({aiNotes:process.env.QX_A1}))' "$2")" || return 1
  _qx_require_ref "$1" || return 1
  qapi PATCH "/api/tasks/$1" "$body" >/dev/null
}

# qx_task_comment TASK_ID BODY  -> POST /api/tasks/$ID/comments {body}
qx_task_comment() {
  local body
  body="$(_qx_node 'process.stdout.write(JSON.stringify({body:process.env.QX_A1}))' "$2")" || return 1
  _qx_require_ref "$1" || return 1
  qapi POST "/api/tasks/$1/comments" "$body" >/dev/null
}

# qx_task_type TASK_ID TYPE  -> PATCH /api/tasks/$ID {type}
qx_task_type() {
  local body
  body="$(_qx_node 'process.stdout.write(JSON.stringify({type:process.env.QX_A1}))' "$2")" || return 1
  _qx_require_ref "$1" || return 1
  qapi PATCH "/api/tasks/$1" "$body" >/dev/null
}

# ---------------------------------------------------------------------------
# TASK REFERENCES — human identifier vs UUID.
#
# A task has TWO names: an opaque UUID (`id`, what the database stores and what
# `parentTaskId` / `dependsOnTaskId` are) and a computed human identifier
# (`CODE-N` for a top-level task, `CODE-N.C` for an epic child). The operator,
# the payload, and every slash command speak the human form. Confusing the two
# is what made epics silently produce top-level cards, so everything below
# resolves ONE way — human -> UUID — before it writes anything.
#
# WHY THE CLIENT RESOLVES INSTEAD OF LETTING THE SERVER DO IT. The current
# server does accept either form (it runs the reference through resolveTaskRef).
# But a task has no DELETE (405): a create that lands wrong is permanent junk on
# the board. Resolving here buys three things a server-side convenience cannot:
# the parent is proven to EXIST before anything is created, an empty/blank
# reference is caught before it becomes a request (the server's own
# `if (data.parentTaskId)` truthiness test turns "" into a silent TOP-LEVEL
# create that still answers 201 — see qx_create_child), and the write stops
# depending on a server behavior this client cannot verify at call time.
# ---------------------------------------------------------------------------

# _qx_trim STRING -> print STRING with leading/trailing whitespace removed.
#   Whitespace-only arguments are the disguise an empty argument wears when it
#   comes out of a payload field or a mis-quoted shell variable.
# _qx_require_ref REF  -> 0 if REF is a task reference and nothing else.
#   SEC-EPIC-2b. Every helper below interpolates its argument into the request PATH, and curl
#   performs RFC 3986 dot-segment removal BEFORE sending — so `../admin/secrets` leaves as
#   `GET /api/admin/secrets`, carrying the bearer token to a caller-chosen endpoint. qapi is
#   built so the token never reaches argv or a log; that is worth nothing if the PATH is
#   attacker-chosen. This predates the epic work (it was already reachable through
#   qx_is_unblocked on main) and is closed here for every call site at once.
#   A ref is a human identifier (SMA-1, or a child's SMA-1.2) or a UUID. Nothing else.
#   The check is on the WHOLE value: grep -E '^...$' anchors PER LINE, so an embedded newline
#   ("SMA-1\n../admin/secrets") satisfied a naive anchored match. Control characters are
#   rejected outright rather than relying on curl's parser to refuse them downstream.
_qx_require_ref() {
  local ref="${1-}"
  case "$ref" in
    *[![:print:]]*) echo "quetrex-api: task reference contains a control character — refusing" >&2; return 1 ;;
  esac
  case "$ref" in
    *$'\n'*|*$'\r'*|*/*|*..*) echo "quetrex-api: refusing a task reference that is not an identifier or a UUID: '$ref'" >&2; return 1 ;;
  esac
  if printf '%s' "$ref" | grep -qxE '[A-Za-z][A-Za-z0-9]*-[0-9]+(\.[0-9]+)?|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'; then
    return 0
  fi
  echo "quetrex-api: refusing a task reference that is not an identifier or a UUID: '$ref'" >&2
  return 1
}

_qx_trim() {
  local s="${1-}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# _qx_task_json REF  -> print the task record for REF (UUID or CODE-N[.C]).
#   Returns 1 (with a message naming REF) if REF is blank or cannot be read.
#   Never issues a request for a blank REF: `GET /api/tasks/` is a different
#   endpoint whose 404 would be reported as "No access", which is a lie.
_qx_task_json() {
  local ref json
  ref="$(_qx_trim "${1-}")"
  if [ -z "$ref" ]; then
    return 1
  fi
  _qx_require_ref "$ref" || return 1
  json="$(qapi GET "/api/tasks/$ref")" || return 1
  printf '%s' "$json"
}

# _qx_task_uuid REF  -> print the UUID of the task REF names.
#   The single hop from a human identifier to the id the API stores.
# shellcheck disable=SC2016
_qx_task_uuid() {
  local ref json
  ref="$(_qx_trim "${1-}")"
  if [ -z "$ref" ]; then
    echo "quetrex-api: missing task id" >&2
    return 1
  fi
  json="$(_qx_task_json "$ref")" || {
    echo "quetrex-api: could not read task '$ref'" >&2
    return 1
  }
  _qx_node '
    let o; try { o = JSON.parse(process.env.QX_A1); } catch { process.exit(1); }
    const id = typeof o.id === "string" ? o.id : "";
    if (!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(id)) {
      process.exit(1);
    }
    process.stdout.write(id);
  ' "$json" || {
    echo "quetrex-api: task '$ref' came back without a usable id" >&2
    return 1
  }
}

# qx_create_child EPIC_ID TITLE [DESC]
#   Create a child of an epic and print the child's human identifier
#   (CODE-N.C) on stdout — one line, nothing else. Returns non-zero, printing
#   NOTHING on stdout, on every failure path. Requires QX_PROJECT_CODE
#   (resolve_project). EPIC_ID is the parent's human id (a UUID also works).
#
#   THE DEFECT THIS IS SHAPED AROUND. "Epics have never worked correctly — it
#   just created a new task instead of a sub task." This function used to
#   JSON.stringify its first argument straight into `parentTaskId` and POST it
#   blind. A blank first argument therefore posted `parentTaskId: ""`, which
#   passes the server's `z.string().nullish()` and then fails its
#   `if (data.parentTaskId)` test — so the server took the TOP-LEVEL branch and
#   answered 201 CREATED. The old code printed the resulting top-level
#   identifier and exited 0: a permanent, undeletable junk card reported as a
#   success. Hence the order below, which is the whole fix:
#
#     1. refuse a blank parent / blank title WITHOUT issuing a request
#     2. GET the parent -> prove it exists and get its UUID
#     3. refuse a parent that is itself a child (one level only, no grandchildren)
#     4. POST with the UUID
#     5. VERIFY the record that came back is really linked (parentTaskId equal
#        to that UUID, childNumber non-null) before printing anything
#
#   Step 5 is not paranoia: it is the only check that can catch a 201 that
#   created the wrong THING, and the operator has to be told which card to
#   reconcile because nothing can delete it for him.
# shellcheck disable=SC2016
qx_create_child() {
  local parent_ref title desc parent_json parent_meta parent_uuid parent_code parent_child body resp ident

  parent_ref="$(_qx_trim "${1-}")"
  title="$(_qx_trim "${2-}")"
  desc="${3-}"

  if [ -z "$parent_ref" ]; then
    echo "quetrex-api create-child: missing epic id (argument 1). Refusing to create anything — an empty parent makes the server create a TOP-LEVEL task, and a task cannot be deleted." >&2
    return 1
  fi
  if [ -z "$title" ]; then
    echo "quetrex-api create-child: missing child title (argument 2). Refusing to create anything." >&2
    return 1
  fi
  if [ -z "${QX_PROJECT_CODE:-}" ]; then
    echo "Run /quetrex-setup:init" >&2
    return 1
  fi

  # Prove the parent exists and get the id the API actually links by.
  parent_json="$(_qx_task_json "$parent_ref")" || {
    echo "quetrex-api create-child: parent task '$parent_ref' could not be read. Refusing to create a child that would land as a top-level task." >&2
    return 1
  }

  # uuid US projectCode US childNumber ("" when top-level) US identifier, where
  # US is \037. NOT tab: tab is IFS *whitespace*, so bash collapses a run of
  # them into one delimiter and drops empty fields — a top-level parent (empty
  # childNumber) would shift `identifier` into `parent_child` and trip the
  # grandchild guard on every single valid parent. \037 is non-whitespace, so
  # every field position is preserved exactly, empty or not.
  parent_meta="$(_qx_node '
    let o; try { o = JSON.parse(process.env.QX_A1); } catch { process.exit(1); }
    const id = typeof o.id === "string" ? o.id : "";
    if (!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(id)) {
      process.exit(2);
    }
    process.stdout.write([
      id,
      o.projectCode == null ? "" : String(o.projectCode),
      o.childNumber == null ? "" : String(o.childNumber),
      o.identifier == null ? "" : String(o.identifier),
    ].join("\u001f"));
  ' "$parent_json")" || {
    echo "quetrex-api create-child: parent task '$parent_ref' came back without a usable UUID id. Refusing to create a child." >&2
    return 1
  }

  IFS=$'\037' read -r parent_uuid parent_code parent_child ident <<<"$parent_meta"

  # One level only — an epic decomposes once; children have no children.
  if [ -n "$parent_child" ]; then
    echo "quetrex-api create-child: '${ident:-$parent_ref}' is itself a child (childNumber=$parent_child). Epics decompose ONE level — no grandchildren. Refusing to create anything." >&2
    return 1
  fi

  # A cross-project parent is a 404 at the server; say what actually happened.
  if [ -n "$parent_code" ] && [ "$parent_code" != "$QX_PROJECT_CODE" ]; then
    echo "quetrex-api create-child: parent '${ident:-$parent_ref}' belongs to project $parent_code, but this repo is bound to $QX_PROJECT_CODE. Refusing to create anything." >&2
    return 1
  fi

  # parentTaskId is the parent's UUID — never its human identifier.
  body="$(_qx_node '
    const parentTaskId = process.env.QX_A1, projectCode = process.env.QX_A2;
    const title = process.env.QX_A3, description = process.env.QX_A4;
    const b = { parentTaskId, projectCode, title };
    if (description) { b.description = description; }
    process.stdout.write(JSON.stringify(b));
  ' "$parent_uuid" "$QX_PROJECT_CODE" "$title" "$desc")" || return 1

  resp="$(qapi POST /api/tasks "$body")" || return 1

  # Trust nothing: a 201 proves a task was created, not that it was created as
  # a CHILD. Print the identifier only if the link is really there.
  _qx_node '
    let o; try { o = JSON.parse(process.env.QX_A1); } catch { process.exit(1); }
    const parentUuid = process.env.QX_A2;
    const parentRef = process.env.QX_A3;
    const code = o.projectCode || o.code || "";
    const ident = o.identifier
      || (code && o.number != null
        ? `${code}-${o.number}${o.childNumber != null ? "." + o.childNumber : ""}`
        : "");
    const linked = typeof o.parentTaskId === "string"
      && o.parentTaskId.toLowerCase() === parentUuid.toLowerCase();
    if (!linked || o.childNumber == null) {
      process.stderr.write(
        `quetrex-api create-child: the server created ${ident || "a task"} as a TOP-LEVEL task ` +
        `(parentTaskId=${JSON.stringify(o.parentTaskId ?? null)}, childNumber=${JSON.stringify(o.childNumber ?? null)}) ` +
        `instead of a child of ${parentRef}. A task cannot be deleted — reconcile the board before retrying.\n`);
      process.exit(3);
    }
    if (!/^[A-Za-z][A-Za-z0-9]*-\d+\.\d+$/.test(ident)) {
      process.stderr.write(
        `quetrex-api create-child: the created child has no CODE-N.C identifier (got ${JSON.stringify(ident)}). ` +
        `The dispatcher and /quetrex:merge key off that shape.\n`);
      process.exit(4);
    }
    process.stdout.write(ident + "\n");
  ' "$resp" "$parent_uuid" "${ident:-$parent_ref}"
}

# qx_add_dep TASK_ID DEPENDS_ON_ID  -> POST /api/tasks/$UUID/dependencies
#   Both ends are human identifiers (or UUIDs) and BOTH are resolved to UUIDs
#   before the write — same human-id/UUID confusion class as create-child, and
#   the same reason for resolving client-side: a blank argument must never
#   become a request, and a reference that does not exist must be named in the
#   error rather than surfacing as a generic "No access".
qx_add_dep() {
  local task_ref dep_ref task_uuid dep_uuid body

  task_ref="$(_qx_trim "${1-}")"
  dep_ref="$(_qx_trim "${2-}")"

  if [ -z "$task_ref" ]; then
    echo "quetrex-api add-dep: missing task id (argument 1). Refusing to call the API." >&2
    return 1
  fi
  if [ -z "$dep_ref" ]; then
    echo "quetrex-api add-dep: missing dependency id (argument 2). Refusing to call the API." >&2
    return 1
  fi

  task_uuid="$(_qx_task_uuid "$task_ref")" || return 1
  dep_uuid="$(_qx_task_uuid "$dep_ref")" || return 1

  if [ "$task_uuid" = "$dep_uuid" ]; then
    echo "quetrex-api add-dep: '$task_ref' cannot depend on itself." >&2
    return 1
  fi

  # shellcheck disable=SC2016
  body="$(_qx_node 'process.stdout.write(JSON.stringify({dependsOnTaskId:process.env.QX_A1}))' "$dep_uuid")" || return 1
  qapi POST "/api/tasks/$task_uuid/dependencies" "$body" >/dev/null
}

# qx_is_unblocked TASK_ID
#   Readiness predicate for the epic DAG dispatch. Exit codes:
#     0  ready      — every dependency is done (or there are none)
#     1  blocked    — at least one dependency is not done yet
#     2  UNDETERMINED — the task could not be read (missing argument, API
#                       failure, unparseable record). Readiness is UNKNOWN.
#   Only 0 may dispatch, so `if quetrex-api is-unblocked X; then ...` is
#   unchanged by the addition of 2. The distinction matters for the tick: a
#   board that is 2 is a broken API, a board that is 1 is simply waiting, and
#   collapsing them makes an outage look like a DAG that never drains.
#
#   Prefers the server's own `isBlocked` flag; falls back to checking every
#   dependency's status against DONE = {merged, deployed, complete} — the same
#   set as the server's DONE_FOR_UNBLOCKING (src/lib/dto.ts), verified against
#   it. This predicate answers ONLY "are the prerequisites done"; whether the
#   task itself still needs building is the caller's business.
qx_is_unblocked() {
  local ref task rc
  ref="$(_qx_trim "${1-}")"
  if [ -z "$ref" ]; then
    echo "quetrex-api is-unblocked: missing task id — readiness UNDETERMINED." >&2
    return 2
  fi
  _qx_require_ref "$ref" || return 1
  task="$(qapi GET "/api/tasks/$ref")" || {
    echo "quetrex-api is-unblocked: could not read '$ref' — readiness UNDETERMINED (do not dispatch)." >&2
    return 2
  }
  _qx_node '
    let o; try { o = JSON.parse(process.env.QX_A1); } catch { process.exit(2); }
    if (o == null || typeof o !== "object") { process.exit(2); }
    const DONE = new Set(["merged", "deployed", "complete"]);
    if (typeof o.isBlocked === "boolean") { process.exit(o.isBlocked ? 1 : 0); }
    const deps = Array.isArray(o.dependencies) ? o.dependencies : [];
    for (const d of deps) {
      const st = (d && (d.status || (d.task && d.task.status))) || "";
      if (!DONE.has(st)) { process.exit(1); }
    }
    process.exit(0);
  ' "$task"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "quetrex-api is-unblocked: '$ref' came back in an unreadable shape — readiness UNDETERMINED (do not dispatch)." >&2
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# ENV-CRED AUTO-DETECT helpers (used by /quetrex-setup:init and /quetrex:deploy).
# A secret VALUE is only ever read inside node, straight from the file, and
# handed to qapi as a JSON body — it never appears on argv (as a value), on
# stdout, or in any log. The only value-derived output is a masked last-4 tail.
# ---------------------------------------------------------------------------

# qx_env_scan DIR
#   Scan DIR for .env, .env.local and .env.* (skipping *.example / *.sample) and
#   print one tab-separated line per relevant credential discovered:
#       <FILE>\t<RAWNAME>\t<CANON>\t****<last4>
#   The full secret VALUE is NEVER printed. All parsing happens in node.
# shellcheck disable=SC2016
qx_env_scan() {
  _qx_node '
    const fs=require("fs"), path=require("path");
    const dir=process.env.QX_A1;
    const NORM={FLY_TOKEN:"FLY_API_TOKEN"};
    const isRelevant=(k)=>
      /(_API_KEY|_SECRET|_TOKEN|_KEY|_PASSWORD|_DSN)$/.test(k)
      || /^(DATABASE_URL|FLY_API_TOKEN|FLY_TOKEN|OPENAI_API_KEY|ANTHROPIC_API_KEY)$/.test(k)
      || /^(STRIPE_|NEON_)/.test(k);
    let files=[];
    try {
      for (const f of fs.readdirSync(dir)) {
        if (f!==".env" && !f.startsWith(".env.")) continue;
        if (/\.(example|sample)$/i.test(f)) continue;
        files.push(path.join(dir,f));
      }
    } catch { process.exit(0); }
    files.sort();
    const found=new Map();   // CANON -> {file, raw, value}
    for (const file of files) {
      let txt; try { txt=fs.readFileSync(file,"utf8"); } catch { continue; }
      for (let line of txt.split(/\r?\n/)) {
        line=line.replace(/^\s*export\s+/,"").trim();
        if (!line || line.startsWith("#")) continue;
        const eq=line.indexOf("="); if (eq<0) continue;
        const k=line.slice(0,eq).trim();
        let v=line.slice(eq+1).trim();
        if ((v.startsWith("\"")&&v.endsWith("\"")) || (v.startsWith("'\''")&&v.endsWith("'\''"))) v=v.slice(1,-1);
        if (!k || !v || !isRelevant(k)) continue;
        const canon=NORM[k]||k;
        const newIsVariant=(NORM[k]!==undefined);
        const existing=found.get(canon);
        if (existing) {
          const existingIsVariant=(existing.raw!==canon);
          if (newIsVariant && !existingIsVariant) continue;   // canonical beats variant
        }
        found.set(canon,{file,raw:k,value:v});
      }
    }
    for (const [canon,info] of found) {
      const v=info.value;
      const last4=v.length>=4 ? v.slice(-4) : v;
      process.stdout.write(`${info.file}\t${info.raw}\t${canon}\t****${last4}\n`);
    }
  ' "$1"
}

# qx_secret_put_from_env ENVFILE RAWNAME CANON
#   Read RAWNAME's value straight from ENVFILE inside node, build the JSON body
#   {name:CANON, value:<value>} and PUT it to the project vault via qapi. The
#   secret VALUE is sourced inside node and never passed as a shell-visible argv
#   value, never echoed, never logged. Requires QX_PROJECT_CODE (resolve_project).
# shellcheck disable=SC2016
qx_secret_put_from_env() {
  local body rc
  body="$(_qx_node '
    const fs=require("fs");
    const file=process.env.QX_A1, raw=process.env.QX_A2, canon=process.env.QX_A3;
    let txt; try { txt=fs.readFileSync(file,"utf8"); } catch { process.exit(1); }
    let val=null;
    for (let line of txt.split(/\r?\n/)) {
      line=line.replace(/^\s*export\s+/,"").trim();
      if (!line || line.startsWith("#")) continue;
      const eq=line.indexOf("="); if (eq<0) continue;
      const k=line.slice(0,eq).trim();
      if (k!==raw) continue;
      let v=line.slice(eq+1).trim();
      if ((v.startsWith("\"")&&v.endsWith("\"")) || (v.startsWith("'\''")&&v.endsWith("'\''"))) v=v.slice(1,-1);
      val=v;   // keep scanning so the LAST definition wins
    }
    if (val==null) { process.exit(1); }
    process.stdout.write(JSON.stringify({name:canon,value:val}));
  ' "$1" "$2" "$3")" || return 1
  qapi PUT "/api/projects/$QX_PROJECT_CODE/secrets" "$body" >/dev/null
  rc=$?
  unset body
  return "$rc"
}

# ---------------------------------------------------------------------------
# DISPATCH — the executable entry point. First arg is either an HTTP method
# (raw authenticated call) or a named subcommand.
# ---------------------------------------------------------------------------
_qx_usage() {
  cat >&2 <<'EOF'
usage:
  quetrex-api <GET|POST|PUT|PATCH|DELETE> <path> [json-body]
  quetrex-api json-get <file> <dot.path>
  quetrex-api kanban-url
  quetrex-api project-code
  quetrex-api code-ok <code>
        exit 0 when <code> is a code the board could have issued. The single
        definition of that shape; resolve_project enforces it, and a caller
        that read the binding some other way asks here rather than
        re-implementing the pattern beside the line it prints.
  quetrex-api repo-norm <value>
        Prints <value> normalised the way the board compares an owner/repo
        (branch-ref.ts: trim, lowercase, strip a trailing .git, then strip
        trailing slashes). Both sides of every comparison go through this.
  quetrex-api binding-path
  quetrex-api env-scan <dir>
  quetrex-api secret-put <envfile> <rawname> <canon>
  quetrex-api task-status <task-id> <status>
  quetrex-api task-ainote <task-id> <note>
  quetrex-api task-comment <task-id> <body>
  quetrex-api task-type <task-id> <type>
  quetrex-api create-child <epic-id> <title> [desc]
        Creates a CHILD of <epic-id> and prints its identifier (CODE-N.C).
        <epic-id> is a human id or a UUID; it is resolved to the parent's UUID
        before anything is created. Refuses (creating nothing) when it is
        blank, unknown, or already a child. Non-zero exit prints no stdout.
  quetrex-api add-dep <task-id> <depends-on-id>
        Both references are resolved to UUIDs before the edge is written.
  quetrex-api is-unblocked <task-id>
        exit 0 = ready, 1 = blocked, 2 = UNDETERMINED (could not read the
        task). Only 0 may dispatch.
EOF
}

_qx_main() {
  local cmd="${1:-}"
  case "$cmd" in
    GET|POST|PUT|PATCH|DELETE)
      resolve_auth || return 1
      qapi "$@"
      ;;
    json-get)     shift; _qx_json_get "$@" ;;
    code-ok)      shift; qx_code_is_board_shaped "${1:-}" ;;
    repo-norm)    shift; qx_repo_norm "${1:-}" ;;
    kanban-url)   resolve_auth    || return 1; printf '%s\n' "$QX_KANBAN_URL" ;;
    project-code) resolve_project || return 1; printf '%s\n' "$QX_PROJECT_CODE" ;;
    binding-path) qx_binding_path ;;
    env-scan)     shift; qx_env_scan "$@" ;;
    secret-put)   shift; resolve_auth || return 1; resolve_project || return 1; qx_secret_put_from_env "$@" ;;
    task-status)  shift; resolve_auth || return 1; qx_task_status "$@" ;;
    task-ainote)  shift; resolve_auth || return 1; qx_task_ainote "$@" ;;
    task-comment) shift; resolve_auth || return 1; qx_task_comment "$@" ;;
    task-type)    shift; resolve_auth || return 1; qx_task_type "$@" ;;
    create-child) shift; resolve_auth || return 1; resolve_project || return 1; qx_create_child "$@" ;;
    add-dep)      shift; resolve_auth || return 1; qx_add_dep "$@" ;;
    is-unblocked) shift; resolve_auth || return 1; qx_is_unblocked "$@" ;;
    ""|-h|--help|help) _qx_usage; return 2 ;;
    *) echo "quetrex-api: unknown command '$cmd'" >&2; _qx_usage; return 2 ;;
  esac
}

_qx_main "$@"
