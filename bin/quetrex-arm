#!/usr/bin/env bash
# shellcheck shell=bash
#
# quetrex-arm — deterministic cloud-arming for /quetrex:init.
#
# WHY A bin/ EXECUTABLE. In plugin slash-command bash, ${CLAUDE_PLUGIN_ROOT} is
# UNSET, so a command cannot source a lib by plugin path — but the plugin's
# bin/ directory IS on PATH, so this tool is callable BY NAME. Before this
# tool existed, the cloud-arming writes lived as inline node prose inside
# .claude/commands/init.md (steps 4h/4i) and, because a slash command's
# markdown prose is not guaranteed to execute verbatim, those writes did not
# reliably land — a repo could finish /quetrex:init with empty enabledPlugins,
# no .mcp.json, and no extraKnownMarketplaces. Moving the logic into a real
# executable makes arming deterministic: it either runs and exits 0, or it
# fails loudly.
#
# usage:
#   quetrex-arm <repo-root> <kanban-url>
#
# Idempotently and non-destructively writes, into <repo-root>:
#
#   .claude/statusline-command.sh
#     The shipped status-bar renderer, copied in beside settings.json.
#
#   .claude/settings.json
#     statusLine = {"type":"command",
#                   "command":"bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/statusline-command.sh\""}
#       WHY ARMING OWNS THIS. Nothing is version-pinned anywhere, so config
#       carries no engine version at all — /quetrex:update and /quetrex:doctor
#       both tell the operator the running version "lives in the status bar".
#       A Claude Code plugin CANNOT register a statusLine, so if arming does
#       not write it into the TARGET repo, the one place the product points at
#       is blank in every armed repo and a teammate stranded on an old engine
#       has no on-screen signal at all. The renderer reads the version at
#       runtime via quetrex-version, so the committed copy never goes stale.
#
#       The ${CLAUDE_PROJECT_DIR:-.} default is load-bearing: the bare form
#       resolves to /.claude/statusline-command.sh when the variable is unset
#       and bash exits 127, which the operator reads as a failed build. A
#       previously-written BARE registration pointing at our own script is
#       therefore REPAIRED to the guarded form; any other statusLine the
#       operator set is left byte-for-byte alone (union-only, never narrow),
#       and an existing .claude/statusline-command.sh in the repo is never
#       overwritten. If the shipped script cannot be located, NO statusLine is
#       registered — never a registration pointing at nothing.
#
#     enabledPlugins["quetrex@quetrex"]        = true
#     enabledPlugins["quetrex-factory@quetrex"] = true
#       NO VERSION PINS. A pinned (array or string) value makes the plugin count
#       as DISABLED for dependency resolution, which stopped the whole quetrex
#       command layer from loading in every armed repo. Booleans only; the engine
#       tracks the marketplace via autoUpdate. Any legacy pin found is rewritten
#       to true.
#     extraKnownMarketplaces.quetrex =
#       {"source":{"source":"github","repo":"Glori-Holdings/quetrex-plugins"},
#        "autoUpdate":true}
#       autoUpdate is required: third-party marketplaces default to OFF, which
#       freezes the catalog and silently strands the whole team on an old engine.
#
# And REMOVES, from <repo-root>:
#
#   .mcp.json
#     mcpServers.quetrex-kanban, when its url is the retired <kanban>/api/mcp
#
#     WHY REMOVE WHAT THIS TOOL USED TO WRITE. Earlier versions registered an
#     http MCP broker at <kanban-url>/api/mcp. That endpoint was never built —
#     the kanban has no /api/mcp route, and the URL answers with the dash's
#     Next.js 404 HTML page. Claude Code therefore tried to connect a broker
#     that could never handshake, so EVERY repo /quetrex:init had ever armed
#     opened with a failing MCP server. Arming now purges that registration
#     instead of writing it, which makes re-running /quetrex:init the
#     remediation path for an already-armed repo. Nothing is lost: the broker
#     never worked. When the endpoint is actually built, re-introduce the write
#     ONLY after the live URL answers an MCP `initialize`.
#
# Every write is a merge: existing keys/servers/plugins the caller did not ask
# about are preserved byte-for-byte in position. Re-running with the same
# inputs on an already-armed repo makes no changes and reports "already
# current" for each concern. Requires node (>=18) and, for the factory-version
# lookup, curl.
#
# Testability: the marketplace URL can be overridden via QX_ARM_MARKET_URL
# (accepts any URL curl understands, including file:// for offline fixtures)
# so tests never depend on network access. The status-bar script's source
# path can be overridden via QX_ARM_STATUSLINE_SRC for the same reason.

set -uo pipefail

MARKET_URL="${QX_ARM_MARKET_URL:-https://raw.githubusercontent.com/Glori-Holdings/quetrex-plugins/main/.claude-plugin/marketplace.json}"

# The ONE registration string. Single-quoted on purpose: ${CLAUDE_PROJECT_DIR:-.}
# is a literal for Claude Code to expand at render time, not something this
# script expands now.
QXARM_STATUSLINE_CMD='bash "${CLAUDE_PROJECT_DIR:-.}/.claude/statusline-command.sh"'

_qxarm_usage() {
  cat >&2 <<'EOF'
usage: quetrex-arm <repo-root> <kanban-url>

Idempotently, non-destructively arms <repo-root> for cloud execution:
  - .claude/settings.json: enabledPlugins pin (quetrex + quetrex-factory),
    extraKnownMarketplaces.quetrex, and the statusLine registration
  - .claude/statusline-command.sh: the status-bar renderer that surfaces the
    running engine version (a plugin cannot register a statusLine itself)
  - .mcp.json: purges the retired mcpServers.quetrex-kanban broker
    (<kanban>/api/mcp), an endpoint that was never built
EOF
}

# _qxarm_resolve_factory_version
#   Print the concrete quetrex-factory version from the marketplace manifest,
#   or empty on any failure (unreachable, bad JSON, entry missing). Never
#   fails the caller — arming still proceeds without the factory pin.
_qxarm_resolve_factory_version() {
  curl -fsS --max-time 8 "$MARKET_URL" 2>/dev/null | node -e '
    let s = "";
    process.stdin.on("data", d => { s += d; }).on("end", () => {
      let o;
      try { o = JSON.parse(s); } catch { process.exit(0); }
      const p = (o.plugins || []).find(x => x && x.name === "quetrex-factory");
      process.stdout.write(p && p.version ? String(p.version) : "");
    });
  ' 2>/dev/null
}

# _qxarm_statusline_src
#   Absolute path to the status-bar renderer this engine ships. bin/ and
#   .claude/ are siblings under the plugin root, so resolve it RELATIVE TO
#   THIS FILE — exactly how bin/quetrex-cleanup finds its own engine lib —
#   because ${CLAUDE_PLUGIN_ROOT} is unset in the slash-command bash that
#   calls this tool. Prints nothing when the location cannot be resolved.
_qxarm_statusline_src() {
  if [ -n "${QX_ARM_STATUSLINE_SRC:-}" ]; then
    printf '%s' "$QX_ARM_STATUSLINE_SRC"
    return 0
  fi
  local self_dir
  self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)" || return 0
  [ -n "$self_dir" ] || return 0
  printf '%s' "$self_dir/.claude/statusline-command.sh"
}

# _qxarm_install_statusline <repo-root>
#   Put the status-bar renderer at <repo-root>/.claude/statusline-command.sh.
#   Prints its report on stdout and, on success, sets QXARM_STATUSLINE_READY=1
#   so the caller knows a registration has something real to point at.
#   NEVER overwrites a script the repo already has (the operator may have
#   customised it) and NEVER fails the run: an unresolvable or uncopyable
#   source just means the status bar is not registered this time.
_qxarm_install_statusline() {
  local repo_root="$1" src dest
  QXARM_STATUSLINE_READY=0
  dest="$repo_root/.claude/statusline-command.sh"

  if [ -f "$dest" ]; then
    echo "statusline-command.sh: already present — left untouched."
    QXARM_STATUSLINE_READY=1
    return 0
  fi

  src="$(_qxarm_statusline_src)"
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    echo "statusline-command.sh: shipped copy not found${src:+ at $src} — status bar not registered." >&2
    return 0
  fi

  mkdir -p "$repo_root/.claude" 2>/dev/null || true
  if cp "$src" "$dest" 2>/dev/null; then
    chmod +x "$dest" 2>/dev/null || true
    echo "statusline-command.sh: installed — the running engine version is surfaced nowhere else."
    QXARM_STATUSLINE_READY=1
  else
    echo "statusline-command.sh: could not be copied from $src — status bar not registered." >&2
  fi
  return 0
}

# _qxarm_write_settings <file> <statusline-command-or-empty>
#   Merge the enabledPlugins pin, the extraKnownMarketplaces entry and (when a
#   command string is given) the statusLine registration into <file>.
#   Never clobbers any other key. Prints a per-concern change report.
_qxarm_write_settings() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [file, slCmd] = process.argv.slice(1);

    let o = {};
    try { o = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}

    o.enabledPlugins = o.enabledPlugins || {};
    const beforePins = JSON.stringify(o.enabledPlugins);
    // NO VERSION PINS. EVER. Both plugins are enabled with a plain boolean and
    // track the marketplace automatically.
    //
    // WHY, measured rather than argued: a version-pinned entry
    // (enabledPlugins["quetrex-factory@quetrex"] = ["1.2.1"]) makes the plugin
    // count as DISABLED for dependency resolution, so the quetrex command layer
    // failed to load entirely and NO /quetrex:* command existed in any armed
    // repo. Verified across four checkouts: pin absent -> enabled; pin true ->
    // enabled; pin ["1.2.1"] (the exact installed version) -> failed to load;
    // pin ["1.1.0"] -> failed to load. The repos with the "correct" concrete pin
    // were the broken ones, and the one that worked did so only because its pin
    // was the floating boolean.
    //
    // Pinning also broke updates in practice: a pin naming a version the machine
    // does not have, or a stale pin nobody bumps, silently strands the engine.
    // Auto-update via extraKnownMarketplaces.autoUpdate is the whole mechanism
    // now. The running version is surfaced in the status bar, not in config.
    // (No apostrophes in this block: the whole node program is a single-quoted
    // shell string, and one would terminate it.)
    o.enabledPlugins["quetrex@quetrex"] = true;
    o.enabledPlugins["quetrex-factory@quetrex"] = true;
    // Strip any legacy version pin left by an older engine: while it is present,
    // the command layer does not load.
    for (const k of Object.keys(o.enabledPlugins)) {
      if (Array.isArray(o.enabledPlugins[k]) || typeof o.enabledPlugins[k] === "string") {
        if (k === "quetrex@quetrex" || k === "quetrex-factory@quetrex") {
          o.enabledPlugins[k] = true;
        }
      }
    }
    const pinsChanged = JSON.stringify(o.enabledPlugins) !== beforePins;

    o.extraKnownMarketplaces = o.extraKnownMarketplaces || {};
    const beforeMkt = JSON.stringify(o.extraKnownMarketplaces.quetrex || null);
    // autoUpdate is REQUIRED, not a nicety. Third-party marketplaces default to
    // auto-update OFF, which leaves the catalog frozen at whatever it was when the
    // marketplace was first added: the session-start update check then compares
    // against stale data, teammates silently run an old engine for weeks, and a
    // published fix never reaches anyone. Declaring it here syncs it to
    // known_marketplaces.json for every member of the repo, with no UI toggle.
    o.extraKnownMarketplaces.quetrex = {
      source: { source: "github", repo: "Glori-Holdings/quetrex-plugins" },
      autoUpdate: true
    };
    const mktChanged = JSON.stringify(o.extraKnownMarketplaces.quetrex) !== beforeMkt;

    // STATUS BAR. A plugin cannot register a statusLine, so the target repo has
    // to carry the registration itself or the running engine version is shown
    // nowhere at all (nothing is version-pinned, so config names no version).
    //
    // Union-only, exactly like every other write here: an existing statusLine
    // is the operator speaking, and it wins. The ONE exception is a repair, not
    // a clobber — a registration that already points at OUR script but omits
    // the ${CLAUDE_PROJECT_DIR:-.} default is rewritten, because the bare form
    // resolves to /.claude/statusline-command.sh when the variable is unset and
    // bash exits 127, which reads to the operator as a failed build.
    let slChanged = false;
    if (slCmd) {
      const cur = o.statusLine;
      const curCmd = (cur && typeof cur === "object" && typeof cur.command === "string") ? cur.command : null;
      if (cur === undefined || cur === null) {
        o.statusLine = { type: "command", command: slCmd };
        slChanged = true;
      } else if (curCmd !== null && /\.claude\/statusline-command\.sh/.test(curCmd) && curCmd !== slCmd) {
        o.statusLine = { type: "command", command: slCmd };
        slChanged = true;
      }
    }

    if (!pinsChanged && !mktChanged && !slChanged) {
      console.log("settings.json: already current.");
      process.exit(0);
    }

    fs.mkdirSync(path.dirname(file) || ".", { recursive: true });
    fs.writeFileSync(file, JSON.stringify(o, null, 2) + "\n");

    const parts = [];
    if (pinsChanged) {
      parts.push(
        "enabledPlugins (quetrex@quetrex=true, quetrex-factory@quetrex=true — no version pins; the engine auto-updates)"
      );
    }
    if (mktChanged) { parts.push("extraKnownMarketplaces.quetrex"); }
    if (slChanged) { parts.push("statusLine (the running engine version has no other home)"); }
    console.log("settings.json: wrote " + parts.join(", "));
  ' "$1" "${2:-}"
}

# _qxarm_purge_dead_mcp <file>
#   Remove the retired quetrex-kanban broker registration from <file>. Only
#   ever touches an entry whose url is the never-built <kanban>/api/mcp
#   endpoint; any other server, any other top-level key, and even a
#   quetrex-kanban entry pointing somewhere else are all left byte-for-byte
#   alone. Deletes the file only when removing our entry leaves it empty —
#   an empty {"mcpServers":{}} is still a config Claude Code loads.
#   NEVER fails the run: a missing, unparseable, or already-clean file is a
#   no-op that reports what it saw and exits 0.
_qxarm_purge_dead_mcp() {
  node -e '
    const fs = require("fs");
    const [file] = process.argv.slice(1);

    let raw;
    try { raw = fs.readFileSync(file, "utf8"); }
    catch { console.log("mcp.json: absent — nothing to remediate."); process.exit(0); }

    let o;
    try { o = JSON.parse(raw); }
    catch { console.log("mcp.json: unparseable — left untouched, fix it by hand."); process.exit(0); }

    const servers = o && o.mcpServers;
    const entry = servers && servers["quetrex-kanban"];
    if (!entry) {
      console.log("mcp.json: no quetrex-kanban broker registered — nothing to remediate.");
      process.exit(0);
    }

    // Match ONLY the endpoint we know does not exist. A team that has pointed
    // this name at something real must keep it.
    const url = String(entry.url || "");
    if (!/\/api\/mcp\/?$/.test(url)) {
      console.log("mcp.json: quetrex-kanban points at " + url + " — not the retired /api/mcp endpoint, left untouched.");
      process.exit(0);
    }

    delete servers["quetrex-kanban"];
    const otherServers = Object.keys(servers).length;
    const otherTopKeys = Object.keys(o).filter(k => k !== "mcpServers").length;

    if (otherServers === 0 && otherTopKeys === 0) {
      fs.unlinkSync(file);
      console.log("mcp.json: removed the dead quetrex-kanban broker (" + url + ") and deleted the now-empty file.");
      process.exit(0);
    }

    fs.writeFileSync(file, JSON.stringify(o, null, 2) + "\n");
    console.log("mcp.json: removed the dead quetrex-kanban broker (" + url + "); " + otherServers + " other server(s) preserved.");
  ' "$1"
}

_qxarm_main() {
  local repo_root="${1:-}" kanban_url="${2:-}"

  if [ -z "$repo_root" ] || [ -z "$kanban_url" ]; then
    _qxarm_usage
    return 2
  fi
  if [ ! -d "$repo_root" ]; then
    echo "quetrex-arm: not a directory: $repo_root" >&2
    return 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    echo "quetrex-arm: node is required" >&2
    return 1
  fi

  # No marketplace lookup: there is no version to resolve because nothing is
  # pinned. Arming is now fully offline-capable.
  #
  # The status-bar script goes in FIRST so the registration below is only ever
  # written once there is a real file for it to point at.
  QXARM_STATUSLINE_READY=0
  _qxarm_install_statusline "$repo_root"
  local sl_cmd=""
  [ "${QXARM_STATUSLINE_READY:-0}" = "1" ] && sl_cmd="$QXARM_STATUSLINE_CMD"
  _qxarm_write_settings "$repo_root/.claude/settings.json" "$sl_cmd" || return 1
  # <kanban-url> is still required (see the -z check above) so the call
  # signature every installed /quetrex:init uses keeps working, but the MCP
  # step no longer builds a URL from it — it only purges the retired broker.
  _qxarm_purge_dead_mcp "$repo_root/.mcp.json" || return 1

  return 0
}

_qxarm_main "$@"
