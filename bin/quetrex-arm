#!/usr/bin/env bash
# shellcheck shell=bash
#
# quetrex-arm — deterministic cloud-arming for /quetrex:init.
#
# WHY A bin/ EXECUTABLE. In plugin slash-command bash, ${CLAUDE_PLUGIN_ROOT} is
# UNSET, so a command cannot source a lib by plugin path — but the plugin's
# bin/ directory IS on PATH, so this tool is callable BY NAME. Before this
# tool existed, the cloud-arming writes lived as inline node prose inside
# .claude/commands/init.md (steps 4h/4i) and, because a slash command's
# markdown prose is not guaranteed to execute verbatim, those writes did not
# reliably land — a repo could finish /quetrex:init with empty enabledPlugins,
# no .mcp.json, and no extraKnownMarketplaces. Moving the logic into a real
# executable makes arming deterministic: it either runs and exits 0, or it
# fails loudly.
#
# usage:
#   quetrex-arm <repo-root> <kanban-url>
#
# Idempotently and non-destructively writes, into <repo-root>:
#
#   .claude/settings.json
#     enabledPlugins["quetrex@quetrex"]        = true
#     enabledPlugins["quetrex-factory@quetrex"] = <concrete version>   (never a
#       floating `true` — resolved from the public marketplace manifest; if the
#       marketplace is unreachable, quetrex@quetrex is still enabled and the
#       factory pin is deferred with a note to run /quetrex:update)
#     extraKnownMarketplaces.quetrex.source =
#       {"source":"github","repo":"Glori-Holdings/quetrex-plugins"}
#
#   .mcp.json
#     mcpServers.quetrex-kanban = {"type":"http","url":"<kanban-url>/api/mcp"}
#     (endpoint only — NEVER a secret value)
#
# Every write is a merge: existing keys/servers/plugins the caller did not ask
# about are preserved byte-for-byte in position. Re-running with the same
# inputs on an already-armed repo makes no changes and reports "already
# current" for each concern. Requires node (>=18) and, for the factory-version
# lookup, curl.
#
# Testability: the marketplace URL can be overridden via QX_ARM_MARKET_URL
# (accepts any URL curl understands, including file:// for offline fixtures)
# so tests never depend on network access.

set -uo pipefail

MARKET_URL="${QX_ARM_MARKET_URL:-https://raw.githubusercontent.com/Glori-Holdings/quetrex-plugins/main/.claude-plugin/marketplace.json}"

_qxarm_usage() {
  cat >&2 <<'EOF'
usage: quetrex-arm <repo-root> <kanban-url>

Idempotently, non-destructively arms <repo-root> for cloud execution:
  - .claude/settings.json: enabledPlugins pin (quetrex + quetrex-factory) and
    extraKnownMarketplaces.quetrex
  - .mcp.json: mcpServers.quetrex-kanban (http broker, endpoint only)
EOF
}

# _qxarm_resolve_factory_version
#   Print the concrete quetrex-factory version from the marketplace manifest,
#   or empty on any failure (unreachable, bad JSON, entry missing). Never
#   fails the caller — arming still proceeds without the factory pin.
_qxarm_resolve_factory_version() {
  curl -fsS --max-time 8 "$MARKET_URL" 2>/dev/null | node -e '
    let s = "";
    process.stdin.on("data", d => { s += d; }).on("end", () => {
      let o;
      try { o = JSON.parse(s); } catch { process.exit(0); }
      const p = (o.plugins || []).find(x => x && x.name === "quetrex-factory");
      process.stdout.write(p && p.version ? String(p.version) : "");
    });
  ' 2>/dev/null
}

# _qxarm_write_settings <file> <factory-version-or-empty>
#   Merge the enabledPlugins pin and extraKnownMarketplaces entry into <file>.
#   Never clobbers any other key. Prints a per-concern change report.
_qxarm_write_settings() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [file, factory] = process.argv.slice(1);

    let o = {};
    try { o = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}

    o.enabledPlugins = o.enabledPlugins || {};
    const beforePins = JSON.stringify(o.enabledPlugins);
    o.enabledPlugins["quetrex@quetrex"] = true;
    if (factory) { o.enabledPlugins["quetrex-factory@quetrex"] = factory; }
    const pinsChanged = JSON.stringify(o.enabledPlugins) !== beforePins;

    o.extraKnownMarketplaces = o.extraKnownMarketplaces || {};
    const beforeMkt = JSON.stringify(o.extraKnownMarketplaces.quetrex || null);
    o.extraKnownMarketplaces.quetrex = {
      source: { source: "github", repo: "Glori-Holdings/quetrex-plugins" }
    };
    const mktChanged = JSON.stringify(o.extraKnownMarketplaces.quetrex) !== beforeMkt;

    if (!pinsChanged && !mktChanged) {
      console.log("settings.json: already current.");
      process.exit(0);
    }

    fs.mkdirSync(path.dirname(file) || ".", { recursive: true });
    fs.writeFileSync(file, JSON.stringify(o, null, 2) + "\n");

    const parts = [];
    if (pinsChanged) {
      parts.push(
        "enabledPlugins (quetrex@quetrex=true"
        + (factory ? ", quetrex-factory@quetrex=" + factory : "; factory pin deferred — marketplace unreachable, run /quetrex:update once online")
        + ")"
      );
    }
    if (mktChanged) { parts.push("extraKnownMarketplaces.quetrex"); }
    console.log("settings.json: wrote " + parts.join(", "));
  ' "$1" "$2"
}

# _qxarm_write_mcp <file> <kanban-url>
#   Merge the quetrex-kanban MCP broker registration into <file>. Never
#   clobbers an existing quetrex-kanban entry or any other server. Endpoint
#   only — no secret value is ever written here.
_qxarm_write_mcp() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [file, kanbanUrl] = process.argv.slice(1);

    let o = {};
    try { o = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}

    o.mcpServers = o.mcpServers || {};
    if (o.mcpServers["quetrex-kanban"]) {
      console.log("mcp.json: already registers the quetrex-kanban broker.");
      process.exit(0);
    }

    o.mcpServers["quetrex-kanban"] = {
      type: "http",
      url: kanbanUrl.replace(/\/$/, "") + "/api/mcp"
    };

    fs.mkdirSync(path.dirname(file) || ".", { recursive: true });
    fs.writeFileSync(file, JSON.stringify(o, null, 2) + "\n");
    console.log("mcp.json: registered the quetrex-kanban broker.");
  ' "$1" "$2"
}

_qxarm_main() {
  local repo_root="${1:-}" kanban_url="${2:-}"

  if [ -z "$repo_root" ] || [ -z "$kanban_url" ]; then
    _qxarm_usage
    return 2
  fi
  if [ ! -d "$repo_root" ]; then
    echo "quetrex-arm: not a directory: $repo_root" >&2
    return 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    echo "quetrex-arm: node is required" >&2
    return 1
  fi

  local factory_version=""
  factory_version="$(_qxarm_resolve_factory_version)"
  if [ -z "$factory_version" ]; then
    echo "quetrex-arm: marketplace unreachable at $MARKET_URL — enabling quetrex@quetrex only; run /quetrex:update once online to pin quetrex-factory." >&2
  fi

  _qxarm_write_settings "$repo_root/.claude/settings.json" "$factory_version" || return 1
  _qxarm_write_mcp "$repo_root/.mcp.json" "$kanban_url" || return 1

  return 0
}

_qxarm_main "$@"
