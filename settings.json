{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx playwright test:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(flyctl status:*)",
      "Bash(npm run type-check:*)",
      "Read(/Users/barnent1/Desktop/**)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf .)",
      "Bash(rm -rf /*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)"
    ],
    "ask": [
      "Bash(fly deploy*)",
      "Bash(flyctl deploy*)",
      "Bash(vercel deploy*)",
      "Bash(netlify deploy*)"
    ],
    "defaultMode": "dontAsk"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/track-modifications.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/config-guard.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/test-guard.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/require-approval.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/enforce-branch.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash /Users/barnent1/.claude/hooks/pre-pr-gate.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/barnent1/.claude/statusline-command.sh"
  },
  "promptSuggestionEnabled": false
}
